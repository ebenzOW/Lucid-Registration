# =========================
# Security & Credentials
# =========================
# The leading slash ensures we only ignore the login.php in the root directory
/db_login.php
/db_login_template.php
*.env
.env

# =========================
# Dependencies & Libraries
# =========================
# Ignore downloaded packages if you eventually use Composer or npm
vendor/
node_modules/

# =========================
# Runtime Data & Uploads
# =========================
# Ignore user-uploaded files or system logs
/uploads/
*.log

# =========================
# OS Generated Clutter
# =========================
# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS / Linux (For graders or future team members)
.DS_Store
.AppleDouble
.LSOverride
._*
*~
*.swp

